{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    // TS 7 no longer auto-includes @types/node here; without this every
    // `process`/`Buffer` reference errors as an unknown global.
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  // Testy patří do běhu vitestu, ne do balíčku. Negace v `files` je navíc
  // nespolehlivá: npm si vynucuje všechno, co začíná na README*, takže
  // `readme.test.js` se do tarballu dostal i přes `!dist/**/*.test.*`.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
